# Nepthic Wholesale — this project's own settings. Nothing here is shared with Events,
# Clothing or the Gateway.

# Its own Postgres database (not the Events or Clothing one).
DATABASE_URL="postgresql://postgres@localhost:5432/nepthic_wholesale"

# Where this site is served, for emails and Stripe redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
# Optional: where the Nepthic logo points. Default "/" (this site's home). Set to the
# gateway (e.g. https://nepthic.com) only if you want the logo to leave the site.
NEXT_PUBLIC_LOGO_HREF="/"

# Payments: "mock" (no Stripe needed, payments succeed instantly) or "stripe".
PAYMENTS_MODE="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (Resend). Without a key, emails go to the console and the email_log table.
RESEND_API_KEY=""
EMAIL_FROM="Nepthic Wholesale <wholesale@nepthic.com>"
ADMIN_NOTIFY_EMAIL="wholesale-team@nepthic.com"

# First admin account (npm run db:seed)
SEED_ADMIN_EMAIL="admin@wholesale.nepthic.com"
SEED_ADMIN_PASSWORD="change-me-now"

# Read-only summary for the optional Nepthic Overview dashboard. Leave empty to turn the
# endpoint off. Generate with: openssl rand -base64 32
OVERVIEW_API_TOKEN=""

# The Clothing catalogue feed this site copies products from, on a schedule.
# https://… for the live store, or file:… for a local file. Wholesale never calls it while
# serving a page, so the Clothing site being down never affects Wholesale.
CLOTHING_CATALOGUE_URL="file:data/clothing-catalogue.sample.json"
CLOTHING_CATALOGUE_TOKEN=""
# Protects /api/cron/catalogue-import (Vercel Cron sends it as a bearer token).
CRON_SECRET=""
